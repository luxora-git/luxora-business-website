# Bitrix24 CRM integration (see lib/integrations/bitrix24.ts)
# Inbound webhook base URL from Bitrix24 (Settings → Developer resources →
# Other → Inbound webhook). Must include the trailing slash.
# Example: https://yourcompany.bitrix24.in/rest/1/xxxxxxxxxxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=

# Optional — CRM "Source" code new leads are tagged with. Defaults to WEB.
BITRIX24_LEAD_SOURCE_ID=

# ── Amazon SES — estimator lead notification emails (lib/integrations/ses.ts)
# IAM user needs the ses:SendEmail permission. SES_FROM_EMAIL must be a
# verified identity in SES (verify the address or its whole domain).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Optional — comma-separated notification recipients.
# Defaults to tech@luxora.in when unset.
SES_NOTIFY_EMAILS=

# Optional — use these instead of the AWS_* names on hosts that reserve
# the AWS_ env namespace (e.g. Vercel). They take precedence when set.
SES_AWS_REGION=
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
