# Bitrix24 CRM integration (see lib/integrations/bitrix24.ts)
# Inbound webhook base URL from Bitrix24 (Settings → Developer resources →
# Other → Inbound webhook). Must include the trailing slash.
# Example: https://yourcompany.bitrix24.in/rest/1/xxxxxxxxxxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=

# Optional — CRM "Source" code new leads are tagged with. Defaults to WEB.
BITRIX24_LEAD_SOURCE_ID=
